#include <stdio.h>
#include <string.h>

int main() {
    char files[20][30];
    int n = 0, choice;
    char name[30];

    while(1) {
        printf("\n1. Create File\n");
        printf("2. Display Files\n");
        printf("3. Delete File\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        if(choice == 1) {
            printf("Enter file name: ");
            scanf("%s", name);

            if(n < 20) {
                strcpy(files[n], name);
                n++;
                printf("File created\n");
            }
        }
        else if(choice == 2) {
            printf("\nFiles in Directory:\n");
            for(int i = 0; i < n; i++)
                printf("%s\n", files[i]);
        }
        else if(choice == 3) {
            printf("Enter file name to delete: ");
            scanf("%s", name);

            int found = 0;

            for(int i = 0; i < n; i++) {
                if(strcmp(files[i], name) == 0) {
                    for(int j = i; j < n - 1; j++)
                        strcpy(files[j], files[j + 1]);
                    n--;
                    found = 1;
                    printf("File deleted\n");
                    break;
                }
            }

            if(!found)
                printf("File not found\n");
        }
        else if(choice == 4) {
            break;
        }
        else {
            printf("Invalid choice\n");
        }
    }

    return 0;
}
