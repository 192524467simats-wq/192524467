#include <stdio.h>
int main() {
    int block[20], process[20], allocation[20];
    int nb, np, i, j, choice, index;

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    printf("Enter sizes of memory blocks:\n");
    for(i = 0; i < nb; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter sizes of processes:\n");
    for(i = 0; i < np; i++)
        scanf("%d", &process[i]);

    printf("\n1. First Fit\n2. Best Fit\n3. Worst Fit\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    for(i = 0; i < np; i++)
        allocation[i] = -1;

    for(i = 0; i < np; i++) {
        index = -1;

        for(j = 0; j < nb; j++) {
            if(block[j] >= process[i]) {
                if(choice == 1) {
                    index = j;
                    break;
                }
                else if(choice == 2) {
                    if(index == -1 || block[j] < block[index])
                        index = j;
                }
                else if(choice == 3) {
                    if(index == -1 || block[j] > block[index])
                        index = j;
                }
            }
        }

        if(index != -1) {
            allocation[i] = index;
            block[index] -= process[i];
        }
    }

    printf("\nProcess\tSize\tBlock\n");

    for(i = 0; i < np; i++) {
        if(allocation[i] != -1)
            printf("P%d\t%d\tB%d\n", i + 1, process[i], allocation[i] + 1);
        else
            printf("P%d\t%d\tNot Allocated\n", i + 1, process[i]);
    }

    return 0;
}
